/* termchat TUI layout */

Screen {
    layout: vertical;
}

Horizontal {
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 1fr;
    border-right: solid $panel;
    background: $surface;
}

#sidebar-title {
    text-style: bold;
    padding: 0 1;
    color: $accent;
}

#tab-bar {
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-1;
}

#sidebar-footer {
    padding: 0 1;
    color: $text-muted;
    dock: bottom;
}

ChatList, ProjectList {
    height: 1fr;
    background: $surface;
}

ChatList > ListItem, ProjectList > ListItem {
    padding: 0 1;
}

ChatList > ListItem.--highlight, ProjectList > ListItem.--highlight {
    background: $accent 20%;
}

ChatPane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

MessageLog {
    height: 1fr;
    padding: 0 1;
}

MessageInput {
    height: auto;
    max-height: 8;
    border-top: solid $panel;
    padding: 0 1;
}

/* Modals */
ConfirmModal, BulkDeleteModal {
    align: center middle;
}

#confirm-dialog {
    width: 50;
    height: auto;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}

#confirm-message {
    padding: 0 0 1 0;
    text-align: center;
}

#confirm-buttons {
    height: auto;
    align: center middle;
}

#confirm-buttons Button {
    margin: 0 1;
}
