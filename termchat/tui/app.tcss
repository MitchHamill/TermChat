/* termchat — terminal-native styling: transparent backgrounds, foreground-only colour */

Screen {
    background: $background;
}

Horizontal {
    height: 1fr;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */

Sidebar {
    width: 22;
    border-right: solid $foreground 20%;
    background: $background;
}

#sidebar-title {
    text-style: bold;
    padding: 0 1;
    border-bottom: solid $foreground 15%;
}

#tab-bar {
    padding: 0 1;
    color: $text-muted;
}

#sidebar-footer {
    padding: 0 1;
    color: $text-muted;
    border-top: solid $foreground 15%;
    dock: bottom;
}

ChatList, ProjectList {
    height: 1fr;
    background: $background;
}

ChatList > ListItem, ProjectList > ListItem {
    padding: 0 1;
    background: $background;
}

/* Cursor highlight: colour + bold only, no background fill */
ChatList > ListItem.--highlight, ProjectList > ListItem.--highlight {
    background: $background;
    color: $accent;
    text-style: bold;
}

/* Bulk-selected items */
ChatItem.bulk-selected > Label {
    color: $success;
    text-style: bold;
}

/* ── Chat pane ───────────────────────────────────────────────────────────── */

ChatPane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    background: $background;
}

MessageLog {
    height: 1fr;
    padding: 0 1;
    background: $background;
}

MessageInput {
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid $foreground 15%;
    background: $background;
}

/* ── Modals ──────────────────────────────────────────────────────────────── */

ConfirmModal, BulkDeleteModal {
    background: $background 75%;
    align: center middle;
}

#confirm-dialog {
    width: 44;
    height: auto;
    border: solid $foreground 50%;
    padding: 1 2;
    background: $background;
}

#confirm-message {
    padding: 0 0 1 0;
    text-align: center;
}

#confirm-keys {
    text-align: center;
    color: $text-muted;
}
