/* termchat — transparent background everywhere; colour only for text */

/* App is the compositor root — must be transparent to show the terminal background */
App {
    background: transparent;
}

Screen {
    background: transparent;
}

Horizontal {
    height: 1fr;
    background: transparent;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */

Sidebar {
    width: 22;
    border-right: solid $foreground 20%;
    background: transparent;
}

#sidebar-title {
    text-style: bold;
    padding: 0 1;
    border-bottom: solid $foreground 15%;
}

#tab-bar {
    padding: 0 1;
    color: $text-muted;
}

#sidebar-footer {
    padding: 0 1;
    color: $text-muted;
    border-top: solid $foreground 15%;
    dock: bottom;
}

ChatList, ProjectList {
    height: 1fr;
    background: transparent;
}

/* Every list row: transparent, no background fill */
ChatList > ListItem, ProjectList > ListItem {
    padding: 0 0;
    background: transparent;
}

/* Cursor row: bold + accent colour only — no background fill */
ChatList > ListItem.--highlight,
ProjectList > ListItem.--highlight {
    background: transparent;
    color: $accent;
    text-style: bold;
}

/* ── Chat pane ───────────────────────────────────────────────────────────── */

ChatPane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    background: transparent;
}

MessageLog {
    height: 1fr;
    padding: 0 1;
    background: transparent;
}

MessageInput {
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid $foreground 15%;
    background: transparent;
}

/* ── Modals ──────────────────────────────────────────────────────────────── */

ConfirmModal, BulkDeleteModal {
    background: $background 60%;
    align: center middle;
}

#confirm-dialog {
    width: 44;
    height: auto;
    border: solid $foreground 60%;
    padding: 1 2;
    background: transparent;
}

#confirm-message {
    padding: 0 0 1 0;
    text-align: center;
}

#confirm-keys {
    text-align: center;
    color: $text-muted;
}
